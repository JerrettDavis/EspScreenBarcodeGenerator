@page "/settings"
@implements IDisposable
@inject ThemeService Theme
@inject DeviceRegistry Devices
@inject BluetoothDeviceRegistry Bluetooth

<PageTitle>Settings - ESP Barcode Control</PageTitle>

<h1 style="margin-top:0;">Settings</h1>

<div class="esb-card">
    <h2>Appearance</h2>
    <p class="esb-muted">Matches the on-device light/dark theme exactly (same palette as the touchscreen UI).</p>
    <div class="esb-btn-row">
        <button class="esb-btn @(Theme.Current == AppTheme.Dark ? "esb-btn-primary" : "")" type="button"
                data-testid="theme-dark" @onclick="@(() => Theme.SetAsync(AppTheme.Dark))">🌙 Dark</button>
        <button class="esb-btn @(Theme.Current == AppTheme.Light ? "esb-btn-primary" : "")" type="button"
                data-testid="theme-light" @onclick="@(() => Theme.SetAsync(AppTheme.Light))">☀️ Light</button>
    </div>
</div>

<div class="esb-card">
    <h2>About</h2>
    <table class="esb-table">
        <tbody>
        <tr><td>Transport</td><td>Bluetooth LE GATT, Web Serial at 115200 baud, and USB-to-ESP-NOW gateway relay</td></tr>
        <tr><td>Control protocols</td><td>EspLink v2 over BLE/gateway plus NDJSON v1 over direct serial</td></tr>
        <tr><td>Mobile support</td><td>Chrome on Android over HTTPS. Web Bluetooth is unavailable in iOS browsers; Safari and Firefox are not supported.</td></tr>
        <tr><td>Security</td><td>The current firmware accepts any nearby BLE central. Use only in a controlled lab until authenticated device trust is enabled.</td></tr>
        <tr><td>Connected devices</td><td>@(Devices.Devices.Count + Bluetooth.Devices.Count)</td></tr>
        </tbody>
    </table>
</div>

@code {
    protected override void OnInitialized()
    {
        Theme.Changed += OnChanged;
        Devices.Changed += OnChanged;
    }

    private async void OnChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Theme.Changed -= OnChanged;
        Devices.Changed -= OnChanged;
    }
}
